# Discord application token (never commit the real value)
DISCORD_TOKEN=

# Text channel where the daily poll and report are posted.
# For more than one channel, use POLL_CHANNEL_IDS=123,456 instead.
POLL_CHANNEL_ID=

# Airtable personal access token restricted to the Teemo Polls base.
# Grant only data.records:read and data.records:write at runtime.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Schedule defaults requested for Bangkok.
BOT_TIMEZONE=Asia/Bangkok
POLL_TIME=11:59
REPORT_TIME=17:00

# Existing name-announcer storage setting for Railway.
CLIP_DIR=/data/clips

# Web console runs alongside the bot. Railway provides PORT and
# RAILWAY_PUBLIC_DOMAIN after you generate a public domain (target port 8080).
# Set ADMIN_PUBLIC_URL only for a custom domain or local development.
# ADMIN_PUBLIC_URL=http://127.0.0.1:8080
PORT=8080
WEB_HOST=0.0.0.0
